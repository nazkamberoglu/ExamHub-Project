@model IEnumerable<ExamHubProject.Models.Entities.Exam>

@{
    ViewData["Title"] = "Detail";
}

<h1>Detail</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ExamName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lesson)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QuestionCount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdfPath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OpticalJson)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ExamName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Lesson.LessonID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QuestionCount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PdfPath)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OpticalJson)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ExamID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ExamID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ExamID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
