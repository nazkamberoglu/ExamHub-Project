@model Student

@{
    ViewData["Title"] = "SignIn";
}

<p class="text-center mt-5 title-text">ExamHub Project</p>

<div class="row gp-4 mt-5">
    <div class="col-md-8 mx-auto">

        <div class="card signIn-card">
            <div class="card-body">
                <form asp-action="SignIn" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="StudentName" class="control-label"></label>
                        <input asp-for="StudentName" class="form-control" />
                        <span asp-validation-for="StudentName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StudentLastName" class="control-label"></label>
                        <input asp-for="StudentLastName" class="form-control" />
                        <span asp-validation-for="StudentLastName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="UserName" class="control-label"></label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="card-footer text-center mt-4">
                        <div class="form-group">
                            <input type="submit" value="Sign In" class="btn btn-primary" />
                        </div>

                        <div class="mt-2">
                            <p>
                                Do you already have a student account?
                                <a asp-action="LogIn" asp-controller="Security"
                                   class="btn btn-primary">
                                    Student Log In
                                </a>
                            </p>
                        </div>

                        <div class="mt-2">
                            <p>
                                Are you an admin?
                                <a asp-action="AdminLogin" asp-controller="Security"
                                   class="btn btn-primary">
                                    Admin Log In
                                </a>
                            </p>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (ViewBag.NameError != null)
        {
            <p class="alert-danger">@ViewBag.NameError</p>
        }


        @if (ViewBag.NullError != null)
        {
            <p class="alert-danger">@ViewBag.NullEroor</p>
        }

    </div>
</div>


<style>
    .title-text {
        color: black;
        font-size: 50px;
        font-weight: bold;
    }

    .signIn-card {
        background: #f9fbff;
        border-radius: 22px;
        padding: 40px 35px;
        border: 1px solid #e4eeff;
        box-shadow: 0px 4px 25px rgba(173, 204, 255, 0.25);
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-control {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #d7e4ff;
        padding: 13px 15px;
        font-size: 15px;
        transition: 0.25s;
    }

        .form-control:focus {
            border-color: #a7c8ff;
            box-shadow: 0 0 0 3px rgba(167, 200, 255, 0.35);
        }

    .btn-primary {
        background: linear-gradient(90deg, #e2eeff, #cfe1ff);
        border: none;
        padding: 12px 25px;
        border-radius: 14px;
        font-size: 16px;
        color: #3366aa;
        font-weight: 600;
        transition: 0.25s ease-in-out;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0px 6px 20px rgba(173, 204, 255, 0.45);
            background: linear-gradient(90deg, #d6e6ff, #c1d9ff);
        }

    .card-footer {
        background: #f3f7ff;
        padding: 18px 20px;
        border-top: 1px solid #dce7ff;
        border-radius: 0 0 22px 22px;
    }

        .card-footer p,
        .card-footer a {
            color: #3366aa;
        }

            .card-footer a:hover,
            .card-footer p:hover {
                text-decoration: none;
            }
</style>