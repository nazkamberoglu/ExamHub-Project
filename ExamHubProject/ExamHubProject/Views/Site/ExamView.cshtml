@model ExamVM
@{
    ViewData["Title"] = "ExamView";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="row">
    <div class="col-md-8">
        @if (!string.IsNullOrEmpty(Model.exam.PdfPath)
        && Model.exam.PdfPath.EndsWith(".pdf"))
        {
            <embed src="@Model.exam.PdfPath" type="application/pdf" width="100%" height="600px" />
        }
        else
        {
            <p>PDF Not Found</p>
        }
    </div>

    <div class="col-md-4">
        @for (int i = 1; i <= Model.exam.QuestionCount; i++)
        {
            <table class="table-bordered" border="1" cellpadding="1" cellspacing="2">
                <tr>
                    <td> </td>
                    <td>A</td>
                    <td>B</td>
                    <td>C</td>
                    <td>D</td>
                    <td>E</td>
                </tr>
                <tr>
                    <td>Soru @i</td>
                    <td><input type="radio" name="s@(i)" value="A" /></td>
                    <td><input type="radio" name="s@(i)" value="B" /></td>
                    <td><input type="radio" name="s@(i)" value="C" /></td>
                    <td><input type="radio" name="s@(i)" value="D" /></td>
                    <td><input type="radio" name="s@(i)" value="E" /></td>
                </tr>
            </table>
        }

        <button class="btn btn-success" id="btn-finish">Finish Exam</button>
        <div id="result" class="mt-3"></div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#btn-finish").click(function (e) {
            e.preventDefault();

            var answers = [];
            $("input[type=radio]:checked").each(function () {
                var name = $(this).attr("name");
                var value = $(this).val();
                var qNo = parseInt(name.replace('s', ''));
                answers.push({ questionNo: qNo, answer: value });
            });

            $.ajax({
                url: '/Site/SubmitExam',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ examId: @Model.exam.ExamID, answers: answers }),
                success: function (res) {
                    var score = Math.trunc(res.score);

                    var card = `
                            <div class="card text-white bg-success mb-3">
                                    <div class="card-header">Exam Result</div>
                                <div class="card-body">
                                    <h5 class="card-title">Your Score: ${score}</h5>
                                        <p class="card-text">Congratulations! Your exam has been successfully saved.</p>
                                        <button class="btn btn-primary" id="showKey">View Answer Key</button>
                                    <div id="answerKey" class="mt-2"></div>
                                </div>
                            </div>
                        `;
                    $("#result").html(card);

                    $("#showKey").click(function () {
                        var table = `
                                <table style="
                                    width: 100%;
                                    border-collapse: collapse;
                                    background: #1e1e1e;
                                    color: #fff;
                                    font-weight: bold;
                                    font-size: 18px;
                                    border-radius: 10px;
                                    overflow: hidden;
                                    box-shadow: 0 0 12px rgba(0,0,0,0.5);
                                ">
                                    <thead style="background: #2c2c2c;">
                                        <tr>
                                            <th style="padding: 12px; border-bottom: 2px solid #444; text-align:center;"Question No</th>
                                            <th style="padding: 12px; border-bottom: 2px solid #444; text-align:center;">Answer</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                            `;

                        res.correctAnswers.forEach(function (a) {
                            table += `
                                    <tr style="transition: 0.3s;">
                                        <td style="padding: 10px; border-bottom: 1px solid #333; text-align:center;">${a.QuestionNo}</td>
                                        <td style="padding: 10px; border-bottom: 1px solid #333; text-align:center;">${a.Answer}</td>
                                    </tr>
                                `;
                        });

                        table += `
                                    </tbody>
                                </table>
                            `;

                        $("#answerKey").html(table);
                    });
                },
                error: function (err) {
                    console.log(err);
                    alert("An error occurred, please try again.");
                }
            });
        });
    });
</script>