@model ExamVM
@{
    ViewData["Title"] = "Search";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}
<h4 class="mb-4">Search Results</h4>

@if (Model.SearchExams != null && Model.SearchExams.Any())
{
    <div class="row">
        @foreach (var exam in Model.SearchExams)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">

                        <span class="badge badge-info mb-2">
                            @exam.Lesson.LessonName
                        </span>

                        <h5 class="card-title">
                            @exam.ExamName
                        </h5>

                        <p class="text-muted small mb-4">
                            Exam ID: @exam.ExamID
                        </p>

                        <a asp-action="ExamView"
                           asp-controller="Site"
                           asp-route-id="@exam.ExamID"
                           class="btn btn-primary mt-auto btn-sm">
                            Go to Exam
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning">
        No results found.
    </div>
}
