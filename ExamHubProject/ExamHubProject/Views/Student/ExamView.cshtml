@model ExamVM
@{
    ViewData["Title"] = "ExamView";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="row g-4">
    @foreach (var item in Model.studentExams)
    {
        string scoreColor = item.ExamScore >= 85 ? "bg-success"
        : item.ExamScore >= 60 ? "bg-warning text-dark"
        : "bg-danger";

        <div class="col-md-8 mx-auto mb-4">

            <div class="card exam-card shadow-sm border-0">

                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@item.Exam.ExamName</h5>

                    <span class="badge px-3 py-2 @scoreColor" style="font-size:0.9rem;">
                        @Math.Round(item.ExamScore, 0)
                    </span>
                </div>

                <div class="card-body">
                    <p class="mb-2">
                        <strong>Score</strong>
                        @Math.Round(item.ExamScore, 0)
                    </p>

                    <p class="text-muted mb-0">
                        <strong>Exam Date:</strong>
                        @item.ExamDate.ToString("dd.MM.yyyy HH:mm")
                    </p>
                </div>

            </div>

        </div>
    }
</div>

@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger mt-3 text-center fw-bold">@ViewBag.Error</div>
}

<style>
    .exam-card {
        border-radius: 14px;
        overflow: hidden;
        transition: all 0.35s ease;
    }

        .exam-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

    .card-header {
        font-weight: 600;
        font-size: 1.15rem;
        padding: 1rem 1.25rem;
    }

    .card-body {
        padding: 1.2rem 1.4rem;
    }
</style>