
@{
    ViewData["Title"] = "PasswordVerification";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="row">

    <div class="col-md-8 mx-auto shadow-sm"> 

        <div class="card justify-content-between">

            <p>Please enter your current password</p>

            <input type="password" name="password" />
            <button type="submit" class="btn-success"> Continue </button> 
            <button type="button" class="btn-danger"> Cancel</button>

              
            

        </div>
        @if (ViewBag.ErrorNull != null)
        {
            <div class="card">

                <p class="alert-danger">@ViewBag.ErrorNull</p>


            </div>
        }

       
        @if(ViewBag.Error!=null)
        {
            <div class="card">

                <p class="alert-danger">@ViewBag.Error</p>


            </div>
        }

    </div>


</div>

